{
  "name": "umio",
  "version": "0.1.0",
  "description": "TypeScript-first AI orchestration library for multi-agent workflows.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "umio": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schema.json": "./schema/umio.config.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "example": "tsx examples/chat.ts",
    "example:tools": "tsx examples/tools.ts",
    "example:workflow": "tsx examples/workflow.ts",
    "example:project": "tsx examples/project.ts",
    "example:graph": "tsx examples/graph.ts",
    "test:watch": "vitest",
    "schema": "tsx scripts/generate-schema.ts",
    "prepublishOnly": "npm run schema && npm run build",
    "cli": "tsx src/cli/main.ts",
    "test:postgres": "UMIO_TEST_POSTGRES_URL=${UMIO_TEST_POSTGRES_URL:-postgres://umio:umio@localhost:55432/umio} vitest run test/checkpoint-postgres-server.test.ts",
    "example:skills": "tsx examples/skills.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "openai": "^7.23.0",
    "undici": "^7.30.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
